{
    "name": "gcore/gnode-client",
    "description": "Client library for the gNode (Geodineum Service Node)",
    "type": "library",
    "license": "(MIT OR Apache-2.0)",
    "keywords": ["gcore", "gnode", "service-discovery", "geometric", "valkey", "redis"],
    "authors": [
        {
            "name": "Niels Erik Toren",
            "email": "dev@geodineum.com",
            "homepage": "https://geodineum.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-redis": "^5.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "gCore\\gNode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "gCore\\gNode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=coverage",
        "cs": "phpcs --standard=PSR12 src tests",
        "cs:fix": "phpcbf --standard=PSR12 src tests",
        "analyse": "phpstan analyse src tests --level=7 --memory-limit=2G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
